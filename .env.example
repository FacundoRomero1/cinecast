# Clave de la API de TMDB (The Movie Database) para catálogo infinito y búsquedas en tiempo real
VITE_TMDB_API_KEY=2dca580c2a14b55200e784d157207b4d

# Credenciales OAuth 2.0 de Spotify (https://developer.spotify.com/dashboard)
# En Redirect URIs de tu app de Spotify, agrega: http://localhost:3000/
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Credenciales OAuth 2.0 de Google Cloud Console (https://console.cloud.google.com)
# En Orígenes JavaScript autorizados y URIs de redireccionamiento, agrega: http://localhost:3000/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
